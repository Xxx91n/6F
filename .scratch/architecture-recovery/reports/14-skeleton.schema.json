{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6f.local/schemas/14-skeleton.schema.json",
  "title": "A-014 报告模板共享骨架契约",
  "description": "章顺序锁定（4 章）+ 字段必含清单 + 5 scale x 4 象限 = 20 格交集字段表。骨架锁结构与字段，不锁措辞与渲染样式（spec.md §Decision 6.1 / ADR-0006）。",
  "type": "object",
  "required": [
    "schema_version",
    "quadrants",
    "scales",
    "skeleton",
    "cells"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "decision_ref": {
      "type": "string"
    },
    "adr_ref": {
      "type": "string"
    },
    "blocked_by": {
      "type": "string"
    },
    "quadrants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "structure",
          "behavior",
          "supply_chain",
          "strategy"
        ]
      }
    },
    "scales": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "MACRO-A",
          "MACRO-B",
          "MACRO-C",
          "MICRO-A",
          "MICRO-B"
        ]
      }
    },
    "skeleton": {
      "type": "object",
      "required": [
        "locked",
        "chapters"
      ],
      "additionalProperties": false,
      "properties": {
        "locked": {
          "const": true
        },
        "rule": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "ordinal",
              "locked",
              "fields"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C[1-4]$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "locked": {
                "const": true
              },
              "purpose": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "required",
                    "description"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1,
                      "description": "字段类型或枚举域，如 string / number / enum[a|b] / array[T] / T|null"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scale",
          "quadrant",
          "applicability",
          "origin",
          "machine_checkable",
          "slice_fields"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scale": {
            "type": "string",
            "enum": [
              "MACRO-A",
              "MACRO-B",
              "MACRO-C",
              "MICRO-A",
              "MICRO-B"
            ]
          },
          "quadrant": {
            "type": "string",
            "enum": [
              "structure",
              "behavior",
              "supply_chain",
              "strategy"
            ]
          },
          "applicability": {
            "type": "string",
            "enum": [
              "native",
              "projected",
              "not_applicable"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "machine_checkable": {
            "type": "boolean"
          },
          "slice_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required",
                "description",
                "origin"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}