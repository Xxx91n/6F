{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macro-audit.local/schemas/unit-matrix-1.0.0.json",
  "title": "25 采集单元矩阵 schema (S1-S5 x 5 scale)",
  "description": "formal JSON Schema for the 5-dim x 5-scale collection unit matrix; coverage (complete Cartesian product, unique ids) is additionally enforced by 05-matrix-check.mjs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dimensions",
    "scales",
    "cells",
    "calibration"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "scales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scale"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "cells": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    }
  },
  "$defs": {
    "dimension": {
      "title": "strategic dimension",
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "scale": {
      "title": "audit scale",
      "enum": [
        "MACRO-A",
        "MACRO-B",
        "MACRO-C",
        "MICRO-A",
        "MICRO-B"
      ]
    },
    "thresholdCondition": {
      "title": "SonarQube-style gate condition triple",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "operator",
        "value"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            ">",
            ">=",
            "=="
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "provenance": {
      "title": "threshold origin and calibration window",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "version",
        "calibrated_date",
        "expires_at"
      ],
      "properties": {
        "origin": {
          "enum": [
            "expert",
            "percentile",
            "benchmark",
            "dynamic"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "calibrated_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "bucket": {
          "type": "string"
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "scale",
        "criterion",
        "data_source",
        "threshold",
        "scoring",
        "risk_weight",
        "machine_checkable",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[1-5]x(MACRO|MICRO)-[AB]$|^S[1-5]xMACRO-C$"
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "criterion": {
          "title": "判据",
          "type": "string",
          "minLength": 20
        },
        "data_source": {
          "title": "数据源",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "yellow",
            "red"
          ],
          "properties": {
            "yellow": {
              "$ref": "#/$defs/thresholdCondition"
            },
            "red": {
              "$ref": "#/$defs/thresholdCondition"
            }
          }
        },
        "scoring": {
          "enum": [
            "ratio",
            "percent",
            "count",
            "index"
          ]
        },
        "risk_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "machine_checkable": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "notes": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "tiers",
        "buckets",
        "recalibration_interval_days",
        "pilot_corpus"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 20
        },
        "tiers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "method"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "method": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "recalibration_interval_days": {
          "type": "integer",
          "minimum": 1
        },
        "pilot_corpus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
