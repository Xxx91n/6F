+    }
+    return missCard(subject, {
+      state: 'not_tracked_at_sha',
+      detail: '观测集 head=' + String(headSha).slice(0, 7) + ' 内无该 subject 的 per-file 事实且无血缘边——该 sha 树下不追踪',
