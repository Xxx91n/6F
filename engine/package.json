{
  "name": "macro-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "macro-audit kernel CLI + Agent Plugin (walking skeleton)",
  "license": "UNLICENSED",
  "bin": {
    "macro-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugin.json",
    "mcp.json",
    "manifest.meta.json",
    "skills",
    "extensions",
    ".claude-plugin",
    "LICENSE",
    "CHANGELOG.md",
    "PROVENANCE.md"
  ],
  "scripts": {
    "gen": "node scripts/gen-manifests.mjs",
    "build": "tsc -p tsconfig.json",
    "package": "npm pack --dry-run",
    "smoke": "node test/smoke.test.mjs && node test/collectors.test.mjs",
    "test": "npm run gen && npm run build && npm run smoke",
    "selftest": "node dist/cli.js selftest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2"
  }
}