  "tables": [
    {
      "name": "audit_fact",
      "purpose": "审计事实表（SSOT）。事件只追加、不可改写；5 scale 共享读、各自投影。",
      "append_only": true,
      "inherits_primary": [
        "A-007",
        "A-008",
        "A-010"
      ],
      "columns": [
        {
          "name": "fact_seq",
          "type": "UBIGINT",
          "nullable": false,
          "role": "identity",
          "constraints": [
            "NOT NULL",
            "PRIMARY KEY"
          ],
          "inherits": "A-007",
          "note": "单调追加序号。A-007 单写多读决议使写者唯一，故序列可严格单调；等价 EventStoreDB expectedVersion 的乐观并发心智。"
        },
        {
          "name": "fact_id",
          "type": "VARCHAR(36)",
          "nullable": false,
          "role": "identity",
          "constraints": [
            "NOT NULL",
            "UNIQUE"
          ],
          "inherits": "ADR-0005",
          "note": "事件 UUID。ADR-0005 事件单向写入心智下每次采集一条事件。"
        },
        {
          "name": "schema_version",
          "type": "INTEGER",
          "nullable": false,
          "role": "governance",
          "constraints": [
            "NOT NULL",
            "CHECK(schema_version >= 1)",
            "REFERENCES schema_registry(version)"
          ],
          "inherits": "A-008",
          "note": "A-008 版本演进：schema 不可改、版本号演进。FK 在建表时声明（承接 A-008 教训：DDL 冻结后 ALTER TABLE ADD CONSTRAINT 不可补）。"
        },
        {
          "name": "trace_id",
          "type": "CHAR(32)",
          "nullable": false,
          "role": "correlation",
          "constraints": [
            "NOT NULL",
            "CHECK(regexp_matches(trace_id, '^[0-9a-f]{32}$'))"
          ],
          "inherits": "A-010",
          "note": "A-010 correlation key 前置字段。W3C TraceContext trace-id，32 位小写 hex。"
        },
        {
          "name": "baggage_id",
          "type": "CHAR(32)",
          "nullable": false,
          "role": "correlation",
          "constraints": [
            "NOT NULL",
            "CHECK(regexp_matches(baggage_id, '^[0-9a-f]{32}$'))"
          ],
          "inherits": "A-010",
          "note": "A-010 correlation key 前置字段。OTel Baggage 关联键，32 位小写 hex，用于跨 5 scale 同一 commit/PR 的审计记录关联。"
        },
        {
          "name": "scale",
          "type": "VARCHAR(8)",
          "nullable": false,
          "role": "classification",
          "constraints": [
            "NOT NULL",
            "CHECK(scale IN ('Macro-A','Macro-B','Macro-C','Micro-A','Micro-B'))"
          ],
          "inherits": "CONTEXT",
          "note": "CONTEXT.md 术语 Scale：5 档枚举，禁止 tier/level。"
        },
        {
          "name": "quadrant",
          "type": "VARCHAR(16)",
          "nullable": false,
          "role": "classification",
          "constraints": [
            "NOT NULL",
            "CHECK(quadrant IN ('structure','behavior','supply-chain','strategic'))"
          ],
          "inherits": "CONTEXT",
          "note": "CONTEXT.md 术语 Strategic Quadrant：结构/行为/供应链/战略。"
        },
        {
          "name": "dimension",
          "type": "VARCHAR(2)",
          "nullable": true,
          "role": "classification",
          "constraints": [
            "NULL",
            "CHECK(dimension IS NULL OR dimension IN ('S1','S2','S3','S4','S5'))"
          ],
          "inherits": "CONTEXT",
          "note": "CONTEXT.md S1-S5 战略维。非战略象限的事实为 NULL，第五维在单人仓须降权由消费层处理，不在 schema 层表达。"
        },
        {
          "name": "collector_id",
          "type": "VARCHAR(64)",
          "nullable": false,
          "role": "provenance",
          "constraints": [
            "NOT NULL"
          ],
          "inherits": "R3-D3",
          "note": "R3-D3 确定性采集器标识（adr-structure / positioning-material / git-log）。正对照与真判据共享同族 detector。"
        },
        {
          "name": "repo_ref",
          "type": "VARCHAR(256)",
          "nullable": false,
          "role": "provenance",
          "constraints": [
            "NOT NULL"
          ],
          "inherits": "CONTEXT",
          "note": "CONTEXT.md 术语 Repo Intake：被审计仓库引用。"
        },
        {
          "name": "subject_ref",
          "type": "VARCHAR(512)",
          "nullable": false,
          "role": "provenance",
          "constraints": [
            "NOT NULL"
          ],
          "inherits": "ADR-0005",
          "note": "事实主体（文件路径 / commit SHA / ADR 编号），SSOT 定位键。"
        },
        {
          "name": "evidence_ref",
          "type": "VARCHAR(512)",
          "nullable": false,
          "role": "provenance",
          "constraints": [
            "NOT NULL"
          ],
          "inherits": "CONTEXT",
          "note": "CONTEXT.md 术语 Evidence Gate：引文锚（file:line / sha），支撑 Receipt 可核验回执。"
        },
        {
          "name": "metric",
          "type": "VARCHAR(128)",
          "nullable": false,
          "role": "payload",
          "constraints": [
            "NOT NULL"
          ],
          "inherits": "A-005",
          "note": "A-005 矩阵 metric 名，跨票字段名对齐硬断言的落点。"
        },
        {
          "name": "value_json",
          "type": "VARCHAR",
          "nullable": false,
          "role": "payload",
          "constraints": [
            "NOT NULL",
            "CHECK(json_valid(value_json))"
          ],
          "inherits": "A-005",
          "note": "度量值 JSON 文本。用 VARCHAR + json_valid 而非 JSON 类型，保证 @duckdb/node-api Appender 写入路径稳定。"
        },
        {
          "name": "observed_at",
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "role": "provenance",
          "constraints": [
            "NOT NULL"
          ],
          "inherits": "R3-D3",
          "note": "观测时刻，由采集器给定（确定性，可重放）。不设 DEFAULT。"
        },
        {
          "name": "ingested_at",
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "role": "provenance",
          "constraints": [
            "NOT NULL",
            "DEFAULT current_timestamp"
          ],
          "inherits": "A-007",
          "note": "入库时刻，由唯一写者权威赋值，防止调用方伪造写入时间。"
        }
      ]
    },
    {
      "name": "schema_registry",
      "purpose": "A-008 混合式注册中心的 DuckDB 元数据表。为使 audit_fact.schema_version 的 FK 能在 DDL 冻结前声明，v0 一并建表；事件同样只追加。",
