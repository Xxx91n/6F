      "extraction": [
        "头部字段：- Status: / - Date: / - Deciders: / - Ledger:（列表式，位于 H1 标题之后）",
        "正文章节：## Context / ## Decision / ## Consequences（+ 可选 ## Options / ## Considered Options）",
        "supersede 链：正文内匹配 supersede / superseded by / supersedes（大小写不敏感）"
      ],
      "metrics": [
        {
          "metric": "adr.header_field_present",
          "value_shape": "{field,present,line}",
          "evidence_ref_shape": "<adr path>#L<line>"
        },
        {
          "metric": "adr.section_present",
          "value_shape": "{section,present,line}",
          "evidence_ref_shape": "<adr path>#L<line>"
        },
        {
          "metric": "adr.five_piece_completeness",
          "value_shape": "{present,of,ratio,missing:[]}",
          "evidence_ref_shape": "<adr path>",
          "note": "五件套 = Status / Date / Context / Decision / Consequences；真判据 S2b 输入"
