  "collectors": [
    {
      "id": "adr-structure@v1",
      "family": "adr-structure",
      "dimension": "S2",
      "quadrant": "strategic",
      "default_scale": "Macro-B",
      "input": [
        "注入的 ADR 文件数组 {path, text}"
