        {
          "metric": "adr.supersede_link_present",
          "value_shape": "{present,matches,line}",
          "evidence_ref_shape": "<adr path>#L<line>"
        },
        {
          "metric": "adr.decision_date",
          "value_shape": "{date}",
          "evidence_ref_shape": "<adr path>#L<line>"
        }
      ],
      "subject_ref_shape": "ADR 文件路径"
    },
    {
      "id": "positioning@v1",
      "family": "positioning",
      "dimension": "S1",
      "quadrant": "strategic",
      "default_scale": "Macro-B",
      "input": [
        "注入的意图声明文本（README / roadmap / epic 目标）",
        "注入的实际交付文本（CHANGELOG / PR 标题 / issue label）",
        "注入的关键词抽取配置 {topN, stopwords}（topN 是采集配置，不是判据阈值）"
      ],
      "extraction": [
        "意图文本确定性分词：ASCII 词（长度>=2）+ CJK 2-gram",
        "去停用词（注入表）后按频次降序取 topN 作为定位关键词集合",
        "在实际交付文本中逐词命中统计（大小写不敏感）"
      ],
      "metrics": [
        {
          "metric": "positioning.keyword_coverage",
          "value_shape": "{keywords,hit,ratio,missed:[]}",
          "evidence_ref_shape": "<intent doc path>",
          "note": "真判据 S1 输入"
        },
        {
          "metric": "positioning.keyword_hit",
          "value_shape": "{keyword,hit,intent_count,delivery_count}",
          "evidence_ref_shape": "<intent doc path>"
        },
        {
          "metric": "positioning.drift_anchor",
          "value_shape": "{first_missed_keyword,anchor}",
          "evidence_ref_shape": "<intent doc path>"
        }
      ],
      "subject_ref_shape": "意图声明文档路径"
    },
    {
      "id": "gitlog@v1",
      "family": "gitlog",
      "dimension": null,
      "quadrant": "strategic",
      "default_scale": "Macro-B",
      "input": [
        "注入的 git log 记录数组 {sha, author, date, paths[]}",
        "注入的 ADR 日期映射 {adrPath: date}（来自 adr-structure@v1，构成同族交叉）",
        "注入的目标路径列表"
      ],
      "extraction": [
        "按路径聚合：首现提交（最早 date，同 date 时按 sha 字典序，保证确定性）、提交数、作者分布",
        "与注入的 ADR 日期比对，计算 date 差值天数"
      ],
      "metrics": [
        {
          "metric": "git.first_commit",
          "value_shape": "{path,sha,date}",
          "evidence_ref_shape": "<sha>"
        },
        {
          "metric": "git.commit_count",
          "value_shape": "{path,count}",
          "evidence_ref_shape": "<sha>"
        },
        {
          "metric": "git.author_matrix",
          "value_shape": "{path,authors:[],top_author,top_share}",
          "evidence_ref_shape": "<sha>",
          "note": "为 S5 预留，本票只声明不承载判据"
        },
        {
          "metric": "git.adr_lag_days",
          "value_shape": "{path,adr_date,first_commit_date,delta_days}",
          "evidence_ref_shape": "<sha>",
          "note": "真判据 S2a 事后补写占比的输入信号；跨族（gitlog × adr-structure）"
        }
      ],
      "subject_ref_shape": "被聚合的路径"
    }
